---
// 页眉：网站名、导航栏、语言切换按钮
// Header: site name, navigation, language switch
import HeaderLink from './HeaderLink.astro';
import {
	getLangFromUrl,
	htmlLang,
	languages,
	localizePath,
	otherLang,
	swapLangInPath,
	useTranslations,
} from '../i18n/utils';

interface Props {
	// 语言切换按钮指向的地址。不传 = 同一页面的另一种语言版本
	// Where the language switch points. Omitted = the same page in the other language
	altHref?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const target = otherLang(lang);
const { altHref = swapLangInPath(Astro.url.pathname, target) } = Astro.props;

// 导航栏的栏目。想增减栏目，改这里，并在 src/i18n/ui.ts 里加上对应的文字
// Navigation sections. To add or remove one, edit this list and add its label in src/i18n/ui.ts
const navItems = [
	{ path: 'essays/', label: t('nav.essays') },
	{ path: 'reviews/', label: t('nav.reviews') },
	{ path: 'notes/', label: t('nav.notes') },
	{ path: 'projects/', label: t('nav.projects') },
	{ path: 'moments/', label: t('nav.moments') },
	{ path: 'about/', label: t('nav.about') },
];
---

<header>
	<nav aria-label={t('nav.label')}>
		<a class="site-title" href={localizePath(lang)}>{t('site.title')}</a>
		<div class="internal-links">
			{navItems.map((item) => <HeaderLink href={localizePath(lang, item.path)}>{item.label}</HeaderLink>)}
		</div>
		<div class="tools">
			<a class="search-link" href={localizePath(lang, 'search/')}>{t('nav.search')}</a>
			<a
				class="lang-switch"
				href={altHref}
				hreflang={htmlLang[target]}
				lang={htmlLang[target]}
				title={t('lang.switch')}
			>
				{languages[target]}
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 1em;
	}
	.site-title {
		padding: 1em 0;
		color: rgb(var(--black));
		font-weight: 700;
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	.tools {
		display: flex;
		align-items: center;
		gap: 0.75em;
	}
	.search-link {
		color: rgb(var(--black));
		font-size: 0.9em;
		text-decoration: none;
	}
	.search-link:hover,
	.search-link:focus-visible {
		color: var(--accent);
	}
	.lang-switch {
		padding: 0.2em 0.8em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		color: rgb(var(--black));
		font-size: 0.9em;
		text-decoration: none;
	}
	.lang-switch:hover,
	.lang-switch:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}
	@media (max-width: 720px) {
		/* 小屏幕上，导航栏移到第二行 / On small screens, the navigation moves to its own row */
		.internal-links {
			order: 3;
			width: 100%;
		}
	}
</style>
