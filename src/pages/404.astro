---
// 找不到页面时显示（GitHub Pages 会自动使用它）
// Shown when a page doesn't exist (GitHub Pages uses it automatically)
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Page not found"
			description="The page you’re looking for doesn’t exist."
			translationHref={null}
		/>
	</head>
	<body>
		<main>
			<h1>Page not found</h1>
			<p>The page you’re looking for doesn’t exist or has moved.</p>
			<p><a href="/en/">Go to the English homepage</a></p>
			<hr />
			<div lang="zh-CN">
				<h2>页面不存在</h2>
				<p>你要找的页面不存在，或者已经移动到别处。</p>
				<p><a href="/zh/">前往中文首页</a></p>
			</div>
		</main>
	</body>
</html>
