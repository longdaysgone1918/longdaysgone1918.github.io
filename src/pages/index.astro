---
// 网站根目录 tianranl.com：自动跳转到默认语言（英文）
// Site root (tianranl.com): send visitors to the default language (English)
import { defaultLang } from '../i18n/utils';

const target = `/${defaultLang}/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={new URL(target, Astro.site)} />
		<title>Tianran L</title>
	</head>
	<body>
		<p><a href={target}>English</a></p>
		<p lang="zh-CN"><a href="/zh/">中文</a></p>
	</body>
</html>
