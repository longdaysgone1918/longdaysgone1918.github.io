---
// 单篇文章页面。src/content/blog/en/xxx.md 会生成 /en/blog/xxx/
// Single post page. src/content/blog/en/xxx.md becomes /en/blog/xxx/
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { localizePath, otherLang, splitPostId } from '../../../i18n/utils';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const ids = new Set(posts.map((post) => post.id));

	return posts.flatMap((post) => {
		const parts = splitPostId(post.id);
		// 不在 en/ 或 zh/ 文件夹里的文章会被跳过
		// Posts outside the en/ and zh/ folders are skipped
		if (!parts) return [];

		const other = otherLang(parts.lang);
		const hasTranslation = ids.has(`${other}/${parts.slug}`);
		// 有翻译就跳到对应的文章，没有就跳到另一种语言的文章列表
		// Link to the translation if it exists, otherwise to the other language's post list
		const altHref = hasTranslation
			? localizePath(other, `blog/${parts.slug}/`)
			: localizePath(other, 'blog/');

		return [
			{
				params: { lang: parts.lang, slug: parts.slug },
				props: { post, altHref, hasTranslation },
			},
		];
	});
}

type Props = {
	post: CollectionEntry<'blog'>;
	altHref: string;
	hasTranslation: boolean;
};

const { post, altHref, hasTranslation } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} altHref={altHref} hasTranslation={hasTranslation}>
	<Content />
</BlogPost>
