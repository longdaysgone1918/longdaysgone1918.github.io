---
// 文章列表：只列出当前语言的文章
// Post list: only posts in the current language
import { Image } from 'astro:assets';
import FormattedDate from '../../../components/FormattedDate.astro';
import Page from '../../../layouts/Page.astro';
import { getPostsByLang, postPath } from '../../../lib/posts';
import { getLangStaticPaths, useTranslations, type Lang } from '../../../i18n/utils';

export function getStaticPaths() {
	return getLangStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPostsByLang(lang);
---

<Page title={t('blog.title')} description={t('blog.description')} wide>
	<h1>{t('blog.title')}</h1>
	{posts.length === 0 && <p>{t('blog.empty')}</p>}
	<ul>
		{
			posts.map((post) => (
				<li>
					<a href={postPath(post)}>
						{post.data.heroImage && (
							<Image width={720} height={360} src={post.data.heroImage} alt="" />
						)}
						<h2 class="title">{post.data.title}</h2>
						<p class="date">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</a>
				</li>
			))
		}
	</ul>
</Page>
<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		width: calc(50% - 1rem);
	}
	ul li * {
		text-decoration: none;
		transition: 0.2s ease;
	}
	ul li img {
		margin-bottom: 0.5rem;
		border-radius: 12px;
	}
	ul li a {
		display: block;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		font-size: 1.563em;
		line-height: 1.2;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
	}
	ul li a:hover .title,
	ul li a:hover .date {
		color: var(--accent);
	}
	ul a:hover img {
		box-shadow: var(--box-shadow);
	}
	@media (max-width: 720px) {
		ul {
			gap: 1em;
		}
		ul li {
			width: 100%;
		}
	}
</style>
