---
// 关于页面：正文来自 src/content/pages/<语言>/about.md
// About page: the text comes from src/content/pages/<lang>/about.md
import { getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { getLangStaticPaths, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
	return getLangStaticPaths();
}

const lang = Astro.params.lang as Lang;
const entry = await getEntry('pages', `${lang}/about`);
if (!entry) throw new Error(`Missing file: src/content/pages/${lang}/about.md`);
const { Content } = await render(entry);
---

<Page title={entry.data.title} description={entry.data.description}>
	<div data-pagefind-body>
		<h1>{entry.data.title}</h1>
		<Content />
	</div>
</Page>
