---
// 首页：简介（来自 src/content/pages/<语言>/home.md）+ 各板块的最近更新
// Home: introduction (from src/content/pages/<lang>/home.md) + latest entries across sections
import { getEntry, render } from 'astro:content';
import EntryList from '../../components/EntryList.astro';
import Page from '../../layouts/Page.astro';
import { entryPath, getLatestEntries } from '../../lib/content';
import { getMoments, momentExcerpt, momentPath } from '../../lib/moments';
import { getLangStaticPaths, useTranslations, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
	return getLangStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const intro = await getEntry('pages', `${lang}/home`);
if (!intro) throw new Error(`Missing file: src/content/pages/${lang}/home.md`);
const { Content } = await render(intro);

// 各板块和动态合在一起，取最新的 5 条
// Newest 5 items across all sections and moments
const latest = [
	...(await getLatestEntries(lang, 5)).map(({ section, entry }) => ({
		href: entryPath(section, entry),
		title: entry.data.title,
		date: entry.data.pubDate,
		label: t(`nav.${section}`),
	})),
	...(await getMoments(lang)).slice(0, 5).map((moment) => ({
		href: momentPath(moment),
		title: momentExcerpt(moment),
		date: moment.data.pubDate,
		label: t('nav.moments'),
	})),
]
	.sort((a, b) => b.date.valueOf() - a.date.valueOf())
	.slice(0, 5);
---

<Page title={t('site.title')} description={t('site.description')}>
	<h1>{intro.data.title}</h1>
	<Content />

	{
		latest.length > 0 && (
			<section class="latest">
				<h2>{t('home.latest')}</h2>
				<EntryList items={latest} showDescription={false} />
			</section>
		)
	}
</Page>
<style>
	.latest {
		margin-top: 3em;
	}
	.latest h2 {
		font-size: 1.563em;
	}
</style>
