---
// 首页：简介（来自 src/content/pages/<语言>/home.md）+ 最新文章
// Home: introduction (from src/content/pages/<lang>/home.md) + latest posts
import { getEntry, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Page from '../../layouts/Page.astro';
import { getPostsByLang, postPath } from '../../lib/posts';
import { getLangStaticPaths, localizePath, useTranslations, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
	return getLangStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const intro = await getEntry('pages', `${lang}/home`);
if (!intro) throw new Error(`Missing file: src/content/pages/${lang}/home.md`);
const { Content } = await render(intro);

const latestPosts = (await getPostsByLang(lang)).slice(0, 3);
---

<Page title={t('site.title')} description={t('site.description')}>
	<h1>{intro.data.title}</h1>
	<Content />

	{
		latestPosts.length > 0 && (
			<section class="latest">
				<h2>{t('home.latest')}</h2>
				<ul>
					{latestPosts.map((post) => (
						<li>
							<a href={postPath(post)}>{post.data.title}</a>
							<span class="date">
								<FormattedDate date={post.data.pubDate} />
							</span>
						</li>
					))}
				</ul>
				<p>
					<a href={localizePath(lang, 'blog/')}>{t('home.allPosts')}</a>
				</p>
			</section>
		)
	}
</Page>
<style>
	.latest {
		margin-top: 3em;
	}
	.latest h2 {
		font-size: 1.563em;
	}
	.latest ul {
		padding: 0;
		list-style: none;
	}
	.latest li {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0 1em;
		padding: 0.5em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.date {
		color: rgb(var(--gray));
	}
</style>
